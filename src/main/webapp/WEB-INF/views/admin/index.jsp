<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,com.manishrawat.realestate.model.*,com.manishrawat.realestate.util.Html" %><% List<User> users=(List<User>)request.getAttribute("users"); List<Property> properties=(List<Property>)request.getAttribute("properties"); List<String> logs=(List<String>)request.getAttribute("logs"); Map<String,String> settings=(Map<String,String>)request.getAttribute("settings"); %>
<!DOCTYPE html><html><head><title>Admin Panel</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><div class="nav"><div class="brand">RealEstateMS • Admin</div><div class="navlinks"><a href="<%=request.getContextPath()%>/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/property">Properties</a><a href="<%=request.getContextPath()%>/notifications">Notifications</a><a href="<%=request.getContextPath()%>/profile">Profile</a><a href="<%=request.getContextPath()%>/logout">Logout</a></div></div><div class="wrap"><div class="hero"><h1>Admin Control Panel</h1><p class="muted">Users, listing approvals, system settings and recent activity.</p></div>
<%if(request.getParameter("saved")!=null){%><p class="badge approved">Changes saved.</p><%}if(request.getParameter("error")!=null){%><p class="badge rejected">Please check the submitted values and try again.</p><%}%>
<div class="grid"><div class="card"><div class="muted">Users</div><div class="stat"><%=request.getAttribute("userCount")%></div></div><div class="card"><div class="muted">Pending listings</div><div class="stat"><%=request.getAttribute("pendingCount")%></div></div><div class="card"><div class="muted">Approved listings</div><div class="stat"><%=request.getAttribute("approvedCount")%></div></div><div class="card"><div class="muted">Recent events</div><div class="stat"><%=logs==null?0:logs.size()%></div></div></div>
<div class="card" style="margin-top:20px"><h2>User Management</h2><p class="muted">Disabling preserves rental history and prevents future login.</p><div class="tablewrap"><table class="table"><tr><th>User</th><th>Email</th><th>Role</th><th>Account</th><th>Update role</th><th>Account action</th></tr><%if(users!=null)for(User x:users){%><tr><td><%=Html.escape(x.getName())%></td><td><%=Html.escape(x.getEmail())%></td><td><%=x.getRole()%></td><td><%=x.isActive()?"Active":"Disabled"%></td><td><form method="post" class="actions"><input type="hidden" name="action" value="userRole"><input type="hidden" name="id" value="<%=x.getId()%>"><select name="role"><%for(String role:List.of("TENANT","MANAGER","ADMIN")){%><option <%=role.equals(x.getRole())?"selected":""%>><%=role%></option><%}%></select><button class="btn" type="submit">Save</button></form></td><td><%if(!"ADMIN".equals(x.getRole())){%><form method="post"><input type="hidden" name="action" value="userState"><input type="hidden" name="id" value="<%=x.getId()%>"><input type="hidden" name="active" value="<%=!x.isActive()%>"><button class="btn <%=x.isActive()?"danger":"success"%>" type="submit"><%=x.isActive()?"Disable":"Re-enable"%></button></form><%}else{%>Protected<%}%></td></tr><%}%></table></div></div>
<div class="card" style="margin-top:20px"><h2>Property Approval</h2><div class="tablewrap"><table class="table"><tr><th>Listing</th><th>City</th><th>Manager ID</th><th>Status</th><th>Set status</th></tr><%if(properties!=null)for(Property p:properties){%><tr><td><%=Html.escape(p.getTitle())%></td><td><%=Html.escape(p.getCity())%></td><td><%=p.getManagerId()%></td><td><%=p.getStatus()%></td><td><form method="post" class="actions"><input type="hidden" name="action" value="propertyStatus"><input type="hidden" name="id" value="<%=p.getId()%>"><select name="status"><%for(String st:List.of("PENDING","APPROVED","REJECTED")){%><option <%=st.equals(p.getStatus())?"selected":""%>><%=st%></option><%}%></select><button class="btn" type="submit">Save</button></form></td></tr><%}%></table></div></div>
<div class="card" style="margin-top:20px"><h2>System Settings</h2><form method="post"><input type="hidden" name="action" value="setting"><label>Site name</label><input name="value" maxlength="255" value="<%=Html.escape(settings.getOrDefault("site_name","Online Real Estate Management System"))%>" required><input type="hidden" name="key" value="site_name"><button class="btn" type="submit">Save site name</button></form><form method="post" style="margin-top:16px"><input type="hidden" name="action" value="setting"><input type="hidden" name="key" value="support_email"><label>Support email</label><input name="value" type="email" maxlength="255" value="<%=Html.escape(settings.getOrDefault("support_email",""))%>"><button class="btn" type="submit">Save support email</button></form><form method="post" style="margin-top:16px"><input type="hidden" name="action" value="setting"><input type="hidden" name="key" value="maintenance_mode"><label>Maintenance mode</label><select name="value"><option value="false" <%=Boolean.parseBoolean(settings.getOrDefault("maintenance_mode","false"))?"":"selected"%>>Off</option><option value="true" <%=Boolean.parseBoolean(settings.getOrDefault("maintenance_mode","false"))?"selected":""%>>On</option></select><button class="btn" type="submit">Save</button></form></div>
<div class="card" style="margin-top:20px"><h2>Recent Activity</h2><%if(logs!=null&&!logs.isEmpty()){%><ul><%for(String x:logs){%><li><%=Html.escape(x)%></li><%}%></ul><%}else{%><p class="muted">No activity recorded yet.</p><%}%></div></div></body></html>
