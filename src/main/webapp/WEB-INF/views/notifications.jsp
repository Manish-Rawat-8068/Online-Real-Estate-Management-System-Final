<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,com.manishrawat.realestate.util.Html" %><% List<Map<String,Object>> items=(List<Map<String,Object>>)request.getAttribute("notifications"); %><!doctype html><html><head><title>Notifications</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><div class="nav"><div class="brand">RealEstateMS</div><div class="navlinks"><a href="<%=request.getContextPath()%>/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/property">Properties</a><a href="<%=request.getContextPath()%>/application">Applications</a><a href="<%=request.getContextPath()%>/agreement">Agreements</a><a href="<%=request.getContextPath()%>/messages">Messages</a><a href="<%=request.getContextPath()%>/profile">Profile</a><a href="<%=request.getContextPath()%>/logout">Logout</a></div></div><main class="wrap"><div class="hero"><h1>Notifications</h1><p class="muted">Application updates and messages for your account.</p></div><div class="card tablewrap"><table class="table"><tr><th>Notification</th><th>Message</th><th>Received</th><th>Read</th><th></th></tr><%if(items!=null&&!items.isEmpty())for(Map<String,Object> n:items){%><tr><td><%=Html.escape(n.get("title"))%></td><td><%=Html.escape(n.get("message"))%></td><td><%=Html.escape(n.get("created_at"))%></td><td><%=Boolean.TRUE.equals(n.get("is_read"))?"Read":"Unread"%></td><td><%if(!Boolean.TRUE.equals(n.get("is_read"))){%><form method="post"><input type="hidden" name="id" value="<%=n.get("id")%>"><button class="btn secondary" type="submit">Mark read</button></form><%}%></td></tr><%}else{%><tr><td colspan="5" class="muted">You have no notifications yet.</td></tr><%}%></table></div></main></body></html>
