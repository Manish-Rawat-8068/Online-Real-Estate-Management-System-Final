<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,com.manishrawat.realestate.util.Html" %><% List<Map<String,Object>> contacts=(List<Map<String,Object>>)request.getAttribute("contacts");List<Map<String,Object>> msgs=(List<Map<String,Object>>)request.getAttribute("conversation");Object selected=request.getAttribute("selectedContact"); %><!doctype html><html><head><title>Messages</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><div class="nav"><div class="brand">RealEstateMS</div><div class="navlinks"><a href="<%=request.getContextPath()%>/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/property">Properties</a><a href="<%=request.getContextPath()%>/application">Applications</a><a href="<%=request.getContextPath()%>/agreement">Agreements</a><a href="<%=request.getContextPath()%>/notifications">Notifications</a><a href="<%=request.getContextPath()%>/profile">Profile</a><a href="<%=request.getContextPath()%>/logout">Logout</a></div></div><main class="wrap"><div class="hero"><h1>Messages</h1><p class="muted">Communicate with tenants and managers connected through rental applications.</p></div><div class="grid"><section class="card"><h2>Contacts</h2><%if(contacts!=null&&!contacts.isEmpty())for(Map<String,Object> c:contacts){%><p><a href="?with=<%=c.get("id")%>"><%=Html.escape(c.get("name"))%> · <%=Html.escape(c.get("role"))%></a></p><%}else{%><p class="muted">Contacts appear after a rental application exists.</p><%}%></section><section class="card"><h2>Conversation</h2><%if(msgs!=null){for(Map<String,Object> m:msgs){%><p><b><%=Html.escape(m.get("sender_name"))%></b> <span class="muted small"><%=Html.escape(m.get("sent_at"))%></span><br><%=Html.escape(m.get("message"))%></p><hr><%}%><form method="post"><input type="hidden" name="receiverId" value="<%=Html.escape(selected)%>"><label>Message</label><textarea name="message" maxlength="4000" required></textarea><button class="btn" type="submit">Send</button></form><%}else{%><p class="muted">Choose a contact to view the conversation.</p><%}%></section></div></main></body></html>
