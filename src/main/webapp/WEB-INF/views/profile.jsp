<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.manishrawat.realestate.model.User,com.manishrawat.realestate.util.Html" %><% User u=(User)session.getAttribute("user"); %><!doctype html><html><head><title>My Profile</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><div class="nav"><div class="brand">RealEstateMS</div><div class="navlinks"><a href="<%=request.getContextPath()%>/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/property">Properties</a><a href="<%=request.getContextPath()%>/application">Applications</a><a href="<%=request.getContextPath()%>/agreement">Agreements</a><a href="<%=request.getContextPath()%>/messages">Messages</a><a href="<%=request.getContextPath()%>/notifications">Notifications</a><a href="<%=request.getContextPath()%>/logout">Logout</a></div></div><main class="wrap"><div class="hero"><h1>My Profile</h1><p class="muted">Update the name and phone number shown on your account.</p></div><%if(request.getParameter("saved")!=null){%><p class="badge approved">Profile updated.</p><%}if(request.getParameter("error")!=null){%><p class="badge rejected">Please check the name and phone number.</p><%}%><div class="card"><p><b>Email:</b> <%=Html.escape(u.getEmail())%></p><p><b>Role:</b> <%=Html.escape(u.getRole())%></p><form method="post"><label>Name</label><input name="name" value="<%=Html.escape(u.getName())%>" maxlength="100" required><label>Phone</label><input name="phone" value="<%=Html.escape(u.getPhone())%>" maxlength="30"><button class="btn" type="submit">Save Profile</button></form></div></main></body></html>
