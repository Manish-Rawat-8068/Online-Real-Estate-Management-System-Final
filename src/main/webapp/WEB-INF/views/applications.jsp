<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,com.manishrawat.realestate.model.Application,com.manishrawat.realestate.model.User,com.manishrawat.realestate.util.Html" %><% User u=(User)session.getAttribute("user"); List<Application> apps=(List<Application>)request.getAttribute("applications"); %>
<!doctype html><html><head><title>Applications</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><div class="nav"><div class="brand">RealEstateMS</div><div class="navlinks"><a href="<%=request.getContextPath()%>/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/property">Properties</a><a href="<%=request.getContextPath()%>/agreement">Agreements</a><a href="<%=request.getContextPath()%>/messages">Messages</a><a href="<%=request.getContextPath()%>/notifications">Notifications</a><a href="<%=request.getContextPath()%>/profile">Profile</a><a href="<%=request.getContextPath()%>/logout">Logout</a></div></div><main class="wrap"><div class="hero"><h1>Rental Applications</h1><p class="muted">Review and track applications for approved listings.</p></div><%if(request.getParameter("saved")!=null){%><p class="badge approved">Application updated.</p><%}if(request.getParameter("error")!=null){%><p class="badge rejected">That application could not be updated. Check access and status.</p><%}%><div class="card tablewrap"><table class="table"><tr><th>ID</th><th>Property</th><th>Tenant</th><th>Message</th><th>Status</th><th>Action</th></tr><%if(apps!=null&&!apps.isEmpty())for(Application a:apps){%><tr><td><%=a.id%></td><td><%=Html.escape(a.propertyTitle)%></td><td><%=Html.escape(a.tenantName)%></td><td><%=Html.escape(a.message==null?"-":a.message)%></td><td><span class="badge <%=Html.escape(a.status.toLowerCase())%>"><%=Html.escape(a.status)%></span></td><td><%if("ADMIN".equals(u.getRole())||"MANAGER".equals(u.getRole())){%><form method="post"><input type="hidden" name="id" value="<%=a.id%>"><select name="status"><%for(String st:List.of("PENDING","APPROVED","REJECTED")){%><option <%=st.equals(a.status)?"selected":""%>><%=st%></option><%}%></select><button class="btn" type="submit">Update</button></form><%}else{%>—<%}%></td></tr><%}else{%><tr><td colspan="6" class="muted">No applications to show.</td></tr><%}%></table></div></main></body></html>
