<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.manishrawat.realestate.model.Property,com.manishrawat.realestate.model.User,com.manishrawat.realestate.util.Html" %><% User u=(User)session.getAttribute("user"); List<Property> ps=(List<Property>)request.getAttribute("properties"); %>
<!DOCTYPE html><html><head><title>Properties</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><div class="nav"><div class="brand">RealEstateMS</div><div class="navlinks"><a href="<%=request.getContextPath()%>/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/application">Applications</a><a href="<%=request.getContextPath()%>/agreement">Agreements</a><a href="<%=request.getContextPath()%>/messages">Messages</a><a href="<%=request.getContextPath()%>/notifications">Notifications</a><a href="<%=request.getContextPath()%>/profile">Profile</a><a href="<%=request.getContextPath()%>/logout">Logout</a></div></div><div class="wrap"><div class="hero"><h1>Property Search & Management</h1><p class="muted">Approved properties are visible to tenants. Managers can submit new listings for admin approval.</p></div>
<%if(request.getParameter("saved")!=null){%><p class="badge approved">Property saved and submitted for admin approval.</p><%}String listingError=request.getParameter("error");if(listingError!=null){%><p class="badge rejected"><%=Html.escape(listingError)%></p><%}if(request.getAttribute("searchError")!=null){%><p class="badge rejected"><%=Html.escape(request.getAttribute("searchError"))%></p><%}%>
<div class="card"><form method="get"><div class="formgrid"><div><label>City</label><input name="city" value="<%=Html.escape(request.getParameter("city"))%>" placeholder="e.g. Noida"></div><div><label>Property Type</label><select name="type"><option value="">All types</option><option <%="Apartment".equals(request.getParameter("type"))?"selected":""%>>Apartment</option><option <%="House".equals(request.getParameter("type"))?"selected":""%>>House</option><option <%="Villa".equals(request.getParameter("type"))?"selected":""%>>Villa</option></select></div></div><button class="btn" type="submit">Search</button></form></div>
<div class="grid" style="margin-top:20px"><% if(ps!=null) for(Property p:ps){%><div class="card"><span class="badge approved"><%=Html.escape(p.getStatus())%></span><h2><%=Html.escape(p.getTitle())%></h2><p><b>₹<%=p.getRent()%></b> • <%=Html.escape(p.getPropertyType())%> • <%=p.getBedrooms()%> BHK</p><p class="muted"><%=Html.escape(p.getAddress())%>, <%=Html.escape(p.getCity())%></p><p><%=Html.escape(p.getDescription()==null?"No description":p.getDescription())%></p><% if("TENANT".equals(u.getRole())){%><form method="post" action="application"><input type="hidden" name="action" value="apply"><input type="hidden" name="propertyId" value="<%=p.getId()%>"><input name="message" maxlength="4000" placeholder="Message to manager"><button class="btn success" type="submit">Apply for Rent</button></form><%}%></div><%}%></div>
<% if("MANAGER".equals(u.getRole())){%><div class="card" style="margin-top:22px"><h2>My Listings</h2><div class="tablewrap"><table class="table"><tr><th>Title</th><th>City</th><th>Monthly Rent</th><th>Status</th><th>Actions</th></tr><% List<Property> mine=(List<Property>)request.getAttribute("myProperties"); if(mine!=null) for(Property p:mine){%><tr><td><%=p.getTitle()%></td><td><%=p.getCity()%></td><td>₹<%=p.getRent()%></td><td><span class="badge <%=p.getStatus().toLowerCase()%>"><%=p.getStatus()%></span></td><td><div class="actions"><a class="btn secondary" href="?editId=<%=p.getId()%>">Edit</a><form method="post" onsubmit="return confirm('Delete this listing?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=p.getId()%>"><button class="btn danger" type="submit">Delete</button></form></div></td></tr><%}%></table></div></div><% Property edit=(Property)request.getAttribute("editProperty"); %><div class="card" style="margin-top:22px"><h2><%=edit==null?"Add New Property":"Edit Property"%></h2><p class="muted">New and edited listings require admin approval.</p><form method="post"><input type="hidden" name="action" value="<%=edit==null?"create":"update"%>"><%if(edit!=null){%><input type="hidden" name="id" value="<%=edit.getId()%>"><%}%><div class="formgrid"><div><label>Title</label><input name="title" maxlength="150" value="<%=edit==null?"":Html.escape(edit.getTitle())%>" required></div><div><label>City</label><input name="city" maxlength="80" value="<%=edit==null?"":Html.escape(edit.getCity())%>" required></div><div><label>Address</label><input name="address" maxlength="255" value="<%=edit==null?"":Html.escape(edit.getAddress())%>" required></div><div><label>Rent</label><input name="rent" type="number" min="1" step="0.01" value="<%=edit==null?"":edit.getRent()%>" required></div><div><label>Type</label><select name="type"><option <%=edit!=null&&"Apartment".equals(edit.getPropertyType())?"selected":""%>>Apartment</option><option <%=edit!=null&&"House".equals(edit.getPropertyType())?"selected":""%>>House</option><option <%=edit!=null&&"Villa".equals(edit.getPropertyType())?"selected":""%>>Villa</option></select></div><div><label>Bedrooms</label><input name="bedrooms" type="number" min="0" max="50" value="<%=edit==null?2:edit.getBedrooms()%>"></div></div><label>Description</label><textarea name="description" maxlength="4000"><%=edit==null?"":Html.escape(edit.getDescription())%></textarea><button class="btn" type="submit"><%=edit==null?"Submit for Approval":"Save Changes"%></button></form></div><%}%></div></body></html>
