<%@ page import="java.util.*,com.manishrawat.realestate.model.Property" %><!DOCTYPE html><html><head><title>Properties</title><style>body{font-family:Arial;margin:25px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:15px}.card{border:1px solid #ddd;padding:18px;border-radius:10px}input,select,textarea,button{padding:9px;margin:4px;width:95%}</style></head><body><a href="dashboard">← Dashboard</a><h1>Property Search & Management</h1><form method="get"><input name="city" placeholder="City"><select name="type"><option value="">All types</option><option>Apartment</option><option>House</option><option>Villa</option></select><button>Search Approved Properties</button></form><div class="grid"><% List<Property> ps=(List<Property>)request.getAttribute("properties"); for(Property p:ps){%><div class="card"><h2><%=p.getTitle()%></h2><p><b>₹<%=p.getPrice()%></b> • <%=p.getPropertyType()%> • <%=p.getBedrooms()%> BHK</p><p><%=p.getAddress()%>, <%=p.getCity()%></p><p><%=p.getDescription()%></p><p>Status: <%=p.getStatus()%></p><form method="post" action="application"><input type="hidden" name="action" value="apply"><input type="hidden" name="propertyId" value="<%=p.getId()%>"><input name="message" placeholder="Application message"><button>Apply</button></form></div><%}%></div><hr><h2>Manager: Add Property</h2><form method="post"><input name="title" placeholder="Title" required><input name="address" placeholder="Address" required><input name="city" placeholder="City" required><input name="price" type="number" step="0.01" placeholder="Rent" required><select name="type"><option>Apartment</option><option>House</option><option>Villa</option></select><input name="bedrooms" type="number" placeholder="Bedrooms"><textarea name="description" placeholder="Description"></textarea><button>Add for Admin Approval</button></form></body></html>
