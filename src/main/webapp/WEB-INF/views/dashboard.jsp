<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.manishrawat.realestate.model.User,com.manishrawat.realestate.util.Html" %><% User u=(User)request.getAttribute("user");String base=request.getContextPath(); %><!doctype html><html><head><title>Dashboard</title><link rel="stylesheet" href="<%=base%>/assets/style.css"></head><body><div class="nav"><div class="brand">RealEstateMS</div><div class="navlinks"><a href="<%=base%>/dashboard">Dashboard</a><a href="<%=base%>/property">Properties</a><a href="<%=base%>/application">Applications</a><a href="<%=base%>/agreement">Agreements</a><a href="<%=base%>/messages">Messages</a><a href="<%=base%>/notifications">Notifications (<%=request.getAttribute("unreadCount")%>)</a><a href="<%=base%>/profile">Profile</a><%if("ADMIN".equals(u.getRole())){%><a href="<%=base%>/admin">Admin</a><%}%><a href="<%=base%>/logout">Logout</a></div></div><main class="wrap"><div class="hero"><h1><%=u.getDashboard()%></h1><p class="muted">Welcome, <b><%=Html.escape(u.getName())%></b> · <%=u.getRole()%></p></div><div class="grid">
<%if("ADMIN".equals(u.getRole())){%><div class="card"><h3>Registered users</h3><div class="stat"><%=request.getAttribute("users")%></div></div><div class="card"><h3>Listings awaiting review</h3><div class="stat"><%=request.getAttribute("pending")%></div><a class="btn" href="<%=base%>/admin">Review listings</a></div><div class="card"><h3>System oversight</h3><p>Manage accounts, system settings and activity.</p><a class="btn" href="<%=base%>/admin">Admin panel</a></div><%}else if("MANAGER".equals(u.getRole())){%><div class="card"><h3>My listings</h3><div class="stat"><%=request.getAttribute("properties")%></div><a class="btn" href="<%=base%>/property">Manage properties</a></div><div class="card"><h3>Rental applications</h3><div class="stat"><%=request.getAttribute("applications")%></div><a class="btn" href="<%=base%>/application">Review applications</a></div><div class="card"><h3>Agreements</h3><div class="stat"><%=request.getAttribute("agreements")%></div><a class="btn" href="<%=base%>/agreement">Manage agreements</a></div><%}else{%><div class="card"><h3>Find a home</h3><p>Search approved listings and send a rental application.</p><a class="btn" href="<%=base%>/property">Browse properties</a></div><div class="card"><h3>My applications</h3><div class="stat"><%=request.getAttribute("applications")%></div><a class="btn" href="<%=base%>/application">Track status</a></div><div class="card"><h3>Rental agreements</h3><div class="stat"><%=request.getAttribute("agreements")%></div><a class="btn" href="<%=base%>/agreement">View agreements</a></div><%}%>
<div class="card"><h3>Messages</h3><p>Contact the tenant or manager for an application.</p><a class="btn" href="<%=base%>/messages">Open messages</a></div><div class="card"><h3>Notifications</h3><p><b><%=request.getAttribute("unreadCount")%></b> unread updates.</p><a class="btn secondary" href="<%=base%>/notifications">View notifications</a></div><div class="card"><h3>My profile</h3><p>Keep your account contact details current.</p><a class="btn secondary" href="<%=base%>/profile">Edit profile</a></div></div><div class="card" style="margin-top:20px"><h2>Review 1 feature areas</h2><p class="muted">Role based access · JDBC DAOs · Servlet/JSP views · asynchronous notifications · rental lifecycle.</p></div></main></body></html>
