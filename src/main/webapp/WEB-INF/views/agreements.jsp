<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,com.manishrawat.realestate.model.Application,com.manishrawat.realestate.model.User,com.manishrawat.realestate.util.Html" %><% List<Map<String,Object>> agreements=(List<Map<String,Object>>)request.getAttribute("agreements");List<Application> applications=(List<Application>)request.getAttribute("applications");User u=(User)session.getAttribute("user"); %><!doctype html><html><head><title>Rental Agreements</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/style.css"></head><body><div class="nav"><div class="brand">RealEstateMS</div><div class="navlinks"><a href="<%=request.getContextPath()%>/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/application">Applications</a><a href="<%=request.getContextPath()%>/property">Properties</a><a href="<%=request.getContextPath()%>/messages">Messages</a><a href="<%=request.getContextPath()%>/notifications">Notifications</a><a href="<%=request.getContextPath()%>/profile">Profile</a><a href="<%=request.getContextPath()%>/logout">Logout</a></div></div><main class="wrap"><div class="hero"><h1>Rental Agreements</h1><p class="muted">Create agreements from approved applications and manage agreement status.</p></div><%if(request.getParameter("saved")!=null){%><p class="badge approved">Changes saved.</p><%}if(request.getParameter("error")!=null){%><p class="badge rejected">Agreement details were invalid or the application is not eligible.</p><%}%><div class="card tablewrap"><table class="table"><tr><th>Property</th><th>Tenant</th><th>Dates</th><th>Rent</th><th>Status</th><th>Update</th></tr><%if(agreements!=null&&!agreements.isEmpty())for(Map<String,Object> a:agreements){%><tr><td><%=Html.escape(a.get("title"))%></td><td><%=Html.escape(a.get("tenant_name"))%></td><td><%=Html.escape(a.get("start_date"))%> – <%=Html.escape(a.get("end_date"))%></td><td>₹<%=Html.escape(a.get("rent"))%></td><td><%=Html.escape(a.get("status"))%></td><td><%if("ADMIN".equals(u.getRole())||"MANAGER".equals(u.getRole())){%><form method="post"><input type="hidden" name="id" value="<%=a.get("id")%>"><select name="status"><%for(String x:List.of("ACTIVE","EXPIRED","TERMINATED")){%><option <%=x.equals(a.get("status"))?"selected":""%>><%=x%></option><%}%></select><button class="btn" type="submit">Update</button></form><%}else{%><%=Html.escape(a.get("status"))%><%}%></td></tr><%}else{%><tr><td colspan="6" class="muted">No rental agreements yet.</td></tr><%}%></table></div><%if("ADMIN".equals(u.getRole())||"MANAGER".equals(u.getRole())){%><div class="card" style="margin-top:20px"><h2>Create Agreement</h2><p class="muted">Only approved applications without an agreement can be selected.</p><form method="post"><input type="hidden" name="action" value="create"><label>Approved application</label><select name="applicationId" required><%if(applications!=null)for(Application a:applications){if("APPROVED".equals(a.status)){%><option value="<%=a.id%>">#<%=a.id%> · <%=Html.escape(a.propertyTitle)%> · <%=Html.escape(a.tenantName)%></option><%}}%></select><div class="formgrid"><div><label>Start date</label><input type="date" name="startDate" required></div><div><label>End date</label><input type="date" name="endDate" required></div><div><label>Monthly rent</label><input type="number" name="rent" min="1" step="0.01" required></div></div><button class="btn" type="submit">Create Agreement</button></form></div><%}%></main></body></html>
