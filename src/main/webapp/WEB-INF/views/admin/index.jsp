<%@ page import="java.util.*,com.manishrawat.realestate.model.*" %><!DOCTYPE html><html><body style="font-family:Arial;margin:30px"><a href="dashboard">← Dashboard</a><h1>Admin Control Panel</h1><h2>Users</h2><table border="1" cellpadding="8"><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th></tr><%for(User u:(List<User>)request.getAttribute("users")){%><tr><td><%=u.getId()%></td><td><%=u.getName()%></td><td><%=u.getEmail()%></td><td><%=u.getRole()%></td></tr><%}%></table><h2>Property Approval</h2><table border="1" cellpadding="8"><tr><th>ID</th><th>Title</th><th>Status</th><th>Action</th></tr><%for(Property p:(List<Property>)request.getAttribute("properties")){%><tr><td><%=p.getId()%></td><td><%=p.getTitle()%></td><td><%=p.getStatus()%></td><td><form method="post"><input type="hidden" name="id" value="<%=p.getId()%>"><select name="status"><option>APPROVED</option><option>REJECTED</option></select><button>Save</button></form></td></tr><%}%></table><h2>Activity Monitoring</h2><ul><%for(String x:(List<String>)request.getAttribute("logs")){%><li><%=x%></li><%}%></ul></body></html>
